# OS and editor debris
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Runtime caches and logs
.cache/
cache/
tmp/
temp/
*.log
*.pid

# Dependencies and build outputs
node_modules/
vendor/
dist/
build/
coverage/
.venv/
*.egg-info/
__pycache__/
*.pyc

# Local environment files
.env
.env.*
!.env.example

# Local databases and container volumes
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.tar
*.tar.gz
*.tgz
docker/volumes/
docker/runtime/
runtime-testing/databases/
runtime-testing/logs/
runtime-testing/tmp/

# Restoration runtime debris
docker/restoration-workspaces/pixelpost-*-first-boot/
!docker/restoration-workspaces/.gitkeep
docker/restoration-workspaces/**/includes/pixelpost.php
docker/restoration-workspaces/**/images/*
!docker/restoration-workspaces/**/images/index.html
docker/restoration-workspaces/**/thumbnails/*
!docker/restoration-workspaces/**/thumbnails/index.html

# PixelPost II runtime data
pixelpostii/uploads/
pixelpostii/photoblog.db
pixelpostii/photoblog.db-shm
pixelpostii/photoblog.db-wal

# Historical archive and data directories — excluded from public repo.
# These are private local storage only. Do not stage without explicit authorization.
archive/original-pixelpost/
data/

# Provenance records are the exception — keep them visible to git.
!archive/provenance/
!archive/provenance/**
